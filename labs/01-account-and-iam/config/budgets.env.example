# Copy to .env in this directory (never commit .env).
# Requires: Lab 2 CLI installed and AWS_PROFILE configured.
#
# Two budgets (optional):
#   - Console (runbook 3 billing-alert): name/limit in BUDGET_NAME_CONSOLE / BUDGET_LIMIT_USD_CONSOLE
#   - CLI script (runbook 6): BUDGET_NAME / BUDGET_NAME_CLI — use a DIFFERENT name so verify targets do not clash.
# One console budget alone is enough for guardrails; CLI budget is practice automation.

AWS_PROFILE=lab-admin
BUDGET_EMAIL=you@example.com

# Default names/limits (create script + fallback for verify)
BUDGET_NAME=lab-monthly-spend-cli
BUDGET_LIMIT_USD=10

# Per-target verify (set CONSOLE_* to match your billing-alert.md budget exactly)
BUDGET_NAME_CONSOLE=lab-monthly-spend
BUDGET_LIMIT_USD_CONSOLE=20
BUDGET_NAME_CLI=lab-monthly-spend-cli
BUDGET_LIMIT_USD_CLI=10

# Optional: default verify target when running verify-monthly-cost-budget.sh with no argument (cli|console)
# BUDGET_VERIFY_TARGET=cli
